6, label=\"before\")\n","ax[2].hist(clean_meta[\"hand_frac_after\"], bins=30, alpha=0.6, label=\"after\")\n","ax[2].set_title(\"share of frames with a detected hand\")\n","for a in ax:\n","    a.legend(fontsize=7)\n","plt.tight_layout()\n","plt.savefig(FIG_DIR / \"clean_distributions.png\", dpi=110)\n","plt.show()"]},{"cell_type":"markdown","id":"1f4e7519","metadata":{"papermill":{"duration":0.015034,"end_time":"2026-11-27T23:29:40.917783+00:00","exception":false,"start_time":"2026-11-27T23:29:40.902749+00:00","status":"completed"},"tags":[]},"source":["## 4. Train / validation / test split by signer\n","\n","The split is done by **signer**, not by clip: validation and test signers never appear in training. The metrics therefore measure the ability to generalize to **new people**, which is the real use of the application.\n","\n","A signer cannot be cut in two; so among many random draws of signers we look for the one whose clips best resemble the full dataset: same distribution of words, right size, and every word present."]},{"cell_type":"code","execution_count":42,"id":"0464c8ed","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:29:40.949964Z","iopub.status.busy":"2026-11-27T23:29:40.949539Z","iopub.status.idle":"2026-11-27T23:29:40.955769Z","shell.execute_reply":"2026-11-27T23:29:40.955134Z"},"papermill":{"duration":0.024017,"end_time":"2026-11-27T23:29:40.957344+00:00","exception":false,"start_time":"2026-11-27T23:29:40.933327+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def pick_signers(counts, k, target_share, rng, n_trials=20000):\n","    \"\"\"counts: signers x words table. Picks k signers whose clips best imitate the full dataset.\"\"\"\n","    table = counts.to_numpy()\n","    total = table.sum()\n","    overall = table.sum(0) / total\n","    best, best_score = None, np.inf\n","    for _ in range(n_trials):\n","        rows = rng.choice(len(table), k, replace=False)\n","        c = table[rows].sum(0)\n","        tv = 0.5 * np.abs(c / c.sum() - overall).sum()       # gap in the word distribution (0 = identical)\n","        size_gap = abs(c.sum() / total - target_share)        # size gap\n","        missing = (c < 2).mean()                             # share of almost absent words\n","        score = tv + size_gap + 10 * missing\n","        if score < best_score:\n","            best, best_score = rows, score\n","    return list(counts.index[best])"]},{"cell_type":"code","execution_count":43,"id":"c69b6fc2","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:29:40.989663Z","iopub.status.busy":"2026-11-27T23:29:40.989452Z","iopub.status.idle":"2026-11-27T23:29:42.885583Z","shell.execute_reply":"2026-11-27T23:29:42.884523Z"},"papermill":{"duration":1.913805,"end_time":"2026-11-27T23:29:42.887277+00:00","exception":false,"start_time":"2026-11-27T23:29:40.973472+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>split</th>\n","      <th>clips</th>\n","      <th>share</th>\n","      <th>signers</th>\n","      <th>words present</th>\n","      <th>min clips per word</th>\n","      <th>left-handed signers</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>train</td>\n","      <td>51133</td>\n","      <td>72%</td>\n","      <td>15</td>\n","      <td>250</td>\n","      <td>82</td>\n","      <td>4</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>val</td>\n","      <td>5717</td>\n","      <td>8%</td>\n","      <td>2</td>\n","      <td>250</td>\n","      <td>12</td>\n","      <td>1</td>\n","