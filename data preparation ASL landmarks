# Face contours, as chains of MediaPipe face indices (all of them are in FACE_KEEP)\n","FACE_CONTOURS = {\n","    \"crimson\": [[61, 40, 37, 0, 267, 270, 291, 321, 314, 17, 84, 91, 61],      # outer lips\n","                [78, 82, 13, 312, 308, 317, 14, 87, 78]],                       # inner lips\n","    \"saddlebrown\": [[70, 63, 105, 66, 107], [300, 293, 334, 296, 336]],         # brows\n","    \"tab:cyan\": [[33, 159, 133, 145, 33], [263, 386, 362, 374, 263]],           # eyes\n","    \"tab:green\": [[10, 168, 1], [234, 152, 454]],                               # nose line, cheeks to chin\n","}\n","\n","\n","def draw_skeleton(ax, f, hand_colors=(\"tab:blue\", \"tab:red\")):\n","    \"\"\"Draws one frame f (92, 2): arms, both hands (nodes 0-20 and 21-41) and the face contours.\"\"\"\n","    for a, b in ARM_EDGES:\n","        ax.plot(f[[a, b], 0], f[[a, b], 1], \"k-\", lw=1)\n","    ax.plot(f[[L_WR, R_WR], 0], f[[L_WR, R_WR], 1], \"ko\", ms=3)          # pose wrists\n","    for hand, color in zip((LH, RH), hand_colors):\n","        h = f[hand]\n","        for a, b in HAND_EDGES:\n","            ax.plot(h[[a, b], 0], h[[a, b], 1], \"-\", color=color, lw=1)\n","    for color, chains in FACE_CONTOURS.items():\n","        for chain in chains:\n","            pts = f[[FACE_NODE[lm] for lm in chain]]\n","            ax.plot(pts[:, 0], pts[:, 1], \"-\", color=color, lw=0.7)"]},{"cell_type":"code","execution_count":25,"id":"20e22ce5","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:49.472831Z","iopub.status.busy":"2026-11-27T23:27:49.472215Z","iopub.status.idle":"2026-11-27T23:27:49.47959Z","shell.execute_reply":"2026-11-27T23:27:49.478838Z"},"papermill":{"duration":0.018609,"end_time":"2026-11-27T23:27:49.481013+00:00","exception":false,"start_time":"2026-11-27T23:27:49.462404+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def plot_strip(seqs, labels, n_frames=8, title=\"\", y_down=True, save=None):\n","    \"\"\"One row per clip (T, 92, 2), n_frames evenly spaced snapshots, same zoom for every clip.\"\"\"\n","    finite = np.concatenate([s[np.isfinite(s).all(-1)] for s in seqs])\n","    lo, hi = np.percentile(finite, 1, axis=0), np.percentile(finite, 99, axis=0)\n","    fig, axes = plt.subplots(len(seqs), n_frames, figsize=(1.7 * n_frames, 1.9 * len(seqs)), squeeze=False)\n","    for r, (seq, label) in enumerate(zip(seqs, labels)):\n","        for c, t in enumerate(np.linspace(0, len(seq) - 1, n_frames).astype(int)):\n","            ax = axes[r, c]\n","            draw_skeleton(ax, seq[t])\n","            ax.set_xlim(lo[0], hi[0])\n","            ax.set_ylim((hi[1], lo[1]) if y_down else (lo[1], hi[1]))\n","            ax.set_aspect(\"equal\")\n","            ax.axis(\"off\")\n","            if r == 0:\n","                ax.set_title(f\"t={t}\", fontsize=7)\n","        axes[r, 0].text(-0.05, 0.5, label, transform=axes[r, 0].transAxes, rotation=90, ha=\"right\", va=\"center\", fontsize=7)\n","    fig.suptitle(title, fontsize=9)\n","    plt.tight_layout()\n","    if save:\n","        plt.savefig(FIG_DIR / save, dpi=110)\n","    plt.show()"]},{"cell_type":"code","execution_count":26,"id":"c9802f9e","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:49.499758Z","iopub.status.busy":"2026-11-27T23:27:49.499487Z","iopub.status.idle":"2026-11-27T23:27:51.490703Z","shell.execute_reply":"2026-11-27T23:27:51.49003Z"},"papermill":{"duration":2.004777,"end_time":"2026-11-27T23:27:51.49461+00:00","exception":false,"start_time":"2026-11-27T23:27:49.489833+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1360x760 with 32 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# The word 'thirsty' signed by several signers (raw data, image coordinates)\n","word = \"thirsty\" if (raw_meta[\"sign\"] == \"thirsty\").any() else raw_meta[\"sign\"].iloc[0]\n","rows = raw_meta[raw_meta[\"sign\"] == word].drop_duplicates(\"participant_id\").head(4)\n","plot_strip([get_raw(i) for i in rows.index],\n","           [f\"signer {p}\\n({by_signer.loc[p, 'dominant']})\" for p in rows[\"participant_id\"]],\n","           title=f\"'{word}' raw, by several signers\", save=\"eda_thirsty.png\")"]},{"cell_type":"code","execution_count":27,"id":"5d2c00d6","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:51.517984Z","iopub.status.busy":"2026-11-27T23:27:51.517656Z","iopub.status.idle":"2026-11-27T23:27:52.867975Z","shell.execute_reply":"2026-11-27T23:27:52.867282Z"},"papermill":{"duration":1.364795,"end_time":"2026-11-27T23:27:52.870674+00:00","exception":false,"start_time":"2026-11-27T23:27:51.505879+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1360x570 with 24 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# The worst-quality clips: hand barely detected, longest gap, most points outside the image\n","worst = {\n","    \"hands almost never detected\": raw_meta[~raw_meta[\"no_hand\"]][[\"left_frac\", \"right_frac\"]].max(axis=1).idxmin(),\n","    \"longest detection gap\": np.maximum(raw_meta[\"gap_left\"], raw_meta[\"gap_right\"]).idxmax(),\n","    \"hands outside the image\": raw_meta[\"out_of_frame\"].idxmax(),\n","}\n","plot_strip([get_raw(i) for i in worst.values()],\n","           [f\"{k}\\n'{raw_meta.loc[i, 'sign']}'\" for k, i in worst.items()], title=\"low-quality clips\")"]},{"cell_type":"markdown","id":"ca7fff0e","metadata":{"papermill":{"duration":0.011427,"end_time":"2026-11-27T23:27:52.89419+00:00","exception":false,"start_time":"2026-11-27T23:27:52.882763+00:00","status":"completed"},"tags":[]},"source":["### 2.9 Exploration summary\n","The next cell gathers the numbers that motivate the cleaning of section 3."]},{"cell_type":"code","execution_count":28,"id":"d59539be","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:52.918469Z","iopub.status.busy":"2026-11-27T23:27:52.918185Z","iopub.status.idle":"2026-11-27T23:27:52.929373Z","shell.execute_reply":"2026-11-27T23:27:52.92843Z"},"papermill":{"duration":0.02516,"end_time":"2026-11-27T23:27:52.930934+00:00","exception":false,"start_time":"2026-11-27T23:27:52.905774+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>value</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>clips</th>\n","      <td>94477</td>\n","    </tr>\n","    <tr>\n","      <th>max/min ratio of clips per word</th>\n","      <td>1.39</td>\n","    </tr>\n","    <tr>\n","      <th>left-dominant signers</th>\n","      <td>9</td>\n","    </tr>\n","    <tr>\n","      <th>clips without a hand</th>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>mean share of idle frames</th>\n","      <td>6.2%</td>\n","    </tr>\n","    <tr>\n","      <th>clips &gt; 3x the median duration of their word</th>\n","      <td>14424</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                                              value\n","clips                                         94477\n","max/min ratio of clips per word                1.39\n","left-dominant signers                             9\n","clips without a hand                              0\n","mean share of idle frames                      6.2%\n","clips > 3x the median duration of their word  14424"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Consequences for the cleaning:\n","  * the imbalance between words is small -> weighted sampling is enough, no synthetic data\n","  * there are left-handed signers -> everybody is brought back to a single dominant hand\n","  * many idle frames -> they are trimmed before normalizing the duration\n","  * a few unusable clips (no hand, corrupted, outliers) -> they are removed\n"]}],"source":["summary = {\n","    \"clips\": len(raw_meta),\n","    \"max/min ratio of clips per word\": round(clips_per_word.max() / clips_per_word.min(), 2),\n","    \"left-dominant signers\": int((by_signer[\"dominant\"] == \"left\").sum()),\n","    \"clips without a hand\": int(raw_meta[\"no_hand\"].sum()),\n","    \"mean share of idle frames\": f\"{idle_share.mean():.1%}\",\n","    \"clips > 3x the median duration of their word\": int((ratio > 3).sum()),\n","}\n","display(pd.Series(summary).to_frame(\"value\"))\n","print(\"Consequences for the cleaning:\\n\"\n","      \"  * the imbalance between words is small -> weighted sampling is enough, no synthetic data\\n\"\n","      \"  * there are left-handed signers -> everybody is brought back to a single dominant hand\\n\"\n","      \"  * many idle frames -> they are trimmed before normalizing the duration\\n\"\n","      \"  * a few unusable clips (no hand, corrupted, outliers) -> they are removed\")"]},{"cell_type":"markdown","id":"cb98443c","metadata":{"papermill":{"duration":0.012875,"end_time":"2026-11-27T23:27:52.955259+00:00","exception":false,"start_time":"2026-11-27T23:27:52.942384+00:00","status":"completed"},"tags":[]},"source":["## 3. Data cleaning\n","\n","The cleaning has two parts:\n","\n","1. **Remove** the unusable clips, with one precise rule per kind of problem. Each rule is counted, to know how many clips it removes.\n","2. **Transform** the kept clips, without removing any:\n","   * trim the idle frames (start and end without a hand);\n","   * center and scale (origin = middle of the shoulders, unit = shoulder width);\n","   * bring every signer to a **right dominant hand** (clips of left-handed signers are mirrored left / right);\n","   * fill the detection gaps: a short gap is interpolated, a hand missing for a long time is put **at rest** (below the shoulder);\n","   * use a **single wrist**: the hand wrist replaces the *pose* wrist;\n","   * resample every clip to 64 frames; the real length is kept and used as a condition for the model.\n","\n","The thresholds below are chosen from the distributions of section 2."]},{"cell_type":"code","execution_count":29,"id":"4e6cfea7","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:52.980515Z","iopub.status.busy":"2026-11-27T23:27:52.980263Z","iopub.status.idle":"2026-11-27T23:27:52.988607Z","shell.execute_reply":"2026-11-27T23:27:52.987892Z"},"papermill":{"duration":0.02267,"end_time":"2026-11-27T23:27:52.990188+00:00","exception":false,"start_time":"2026-11-27T23:27:52.967518+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>value</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>idle_margin</th>\n","      <td>2.0</td>\n","    </tr>\n","    <tr>\n","      <th>min_active_frames</th>\n","      <td>5.0</td>\n","    </tr>\n","    <tr>\n","      <th>max_len_ratio</th>\n","      <td>3.0</td>\n","    </tr>\n","    <tr>\n","      <th>shoulder_ratio</th>\n","      <td>3.0</td>\n","    </tr>\n","    <tr>\n","      <th>max_out_of_frame</th>\n","      <td>0.5</td>\n","    </tr>\n","    <tr>\n","      <th>max_gap_interp</th>\n","      <td>8.0</td>\n","    </tr>\n","    <tr>\n","      <th>rest_drop</th>\n","      <td>1.5</td>\n","    </tr>\n","    <tr>\n","      <th>num_frames</th>\n","      <td>64.0</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                   value\n","idle_margin          2.0\n","min_active_frames    5.0\n","max_len_ratio        3.0\n","shoulder_ratio       3.0\n","max_out_of_frame     0.5\n","max_gap_interp       8.0\n","rest_drop            1.5\n","num_frames          64.0"]},"execution_count":29,"metadata":{},"output_type":"execute_result"}],"source":["CLEAN = {\n","    \"idle_margin\": 2,          # frames kept before / after the active part\n","    \"min_active_frames\": 5,    # shorter active part -> clip removed\n","    \"max_len_ratio\": 3.0,      # active part > 3 x the median of the word -> removed\n","    \"shoulder_ratio\": 3.0,     # shoulder width < 1/3 or > 3 x the median -> removed\n","    \"max_out_of_frame\": 0.5,   # more than 50 % of the hand points outside the image -> removed\n","    \"max_gap_interp\": 8,       # detection gap <= 8 frames -> interpolated; longer -> hand at rest\n","    \"rest_drop\": 1.5,          # hand at rest: wrist 1.5 shoulder widths below the shoulder\n","    \"num_frames\": 64,          # fixed length of the clips given to the model\n","}\n","pd.Series(CLEAN).to_frame(\"value\")"]},{"cell_type":"markdown","id":"a592f888","metadata":{"papermill":{"duration":0.01156,"end_time":"2026-11-27T23:27:53.014071+00:00","exception":false,"start_time":"2026-11-27T23:27:53.002511+00:00","status":"completed"},"tags":[]},"source":["### 3.1 Removal rules\n","The rules are applied one after the other; a clip is only counted by the first rule that removes it."]},{"cell_type":"code","execution_count":30,"id":"dedc042b","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.039908Z","iopub.status.busy":"2026-11-27T23:27:53.039571Z","iopub.status.idle":"2026-11-27T23:27:53.083401Z","shell.execute_reply":"2026-11-27T23:27:53.082539Z"},"papermill":{"duration":0.058992,"end_time":"2026-11-27T23:27:53.085251+00:00","exception":false,"start_time":"2026-11-27T23:27:53.026259+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>step</th>\n","      <th>clips</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>clips at the start</td>\n","      <td>94477</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>corrupted or empty file</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>no hand detected</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>shoulders or face never detected</td>\n","      <td>-26</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>active part too short</td>\n","      <td>-8924</td>\n","    </tr>\n","    <tr>\n","      <th>5</th>\n","      <td>abnormal shoulder width</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>6</th>\n","      <td>hands mostly outside the image</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>7</th>\n","      <td>active part too long for the word</td>\n","      <td>-14424</td>\n","    </tr>\n","    <tr>\n","      <th>8</th>\n","      <td>clips kept</td>\n","      <td>71103</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["                                step  clips\n","0                 clips at the start  94477\n","1            corrupted or empty file      0\n","2                   no hand detected      0\n","3   shoulders or face never detected    -26\n","4              active part too short  -8924\n","5            abnormal shoulder width      0\n","6     hands mostly outside the image      0\n","7  active part too long for the word -14424\n","8                         clips kept  71103"]},"metadata":{},"output_type":"display_data"}],"source":["raw_meta[\"active_len\"] = (raw_meta[\"n_frames\"] - raw_meta[\"lead_idle\"] - raw_meta[\"trail_idle\"]).clip(lower=0)\n","word_median_active = raw_meta[~raw_meta[\"no_hand\"]].groupby(\"sign\")[\"active_len\"].median()\n","len_ratio = raw_meta[\"active_len\"] / raw_meta[\"sign\"].map(word_median_active)\n","sw_ratio = raw_meta[\"shoulder_width\"] / raw_meta[\"shoulder_width\"].median()\n","\n","rules = {\n","    \"corrupted or empty file\": ~raw_meta[\"rows_ok\"] | (raw_meta[\"n_frames\"] == 0),\n","    \"no hand detected\": raw_meta[\"no_hand\"],\n","    \"shoulders or face never detected\": raw_meta[\"shoulder_width\"].isna() | (raw_meta[\"face_frac\"] == 0),\n","    \"active part too short\": raw_meta[\"active_len\"] < CLEAN[\"min_active_frames\"],\n","    \"abnormal shoulder width\": (sw_ratio < 1 / CLEAN[\"shoulder_ratio\"]) | (sw_ratio > CLEAN[\"shoulder_ratio\"]),\n","    \"hands mostly outside the image\": raw_meta[\"out_of_frame\"] > CLEAN[\"max_out_of_frame\"],\n","    \"active part too long for the word\": len_ratio > CLEAN[\"max_len_ratio\"],\n","}\n","\n","keep = pd.Series(True, index=raw_meta.index)\n","funnel = [(\"clips at the start\", len(raw_meta))]\n","for name, mask in rules.items():\n","    removed = keep & mask\n","    funnel.append((name, -int(removed.sum())))\n","    keep &= ~mask\n","funnel.append((\"clips kept\", int(keep.sum())))\n","funnel = pd.DataFrame(funnel, columns=[\"step\", \"clips\"])\n","display(funnel)"]},{"cell_type":"markdown","id":"fa4eb0d0","metadata":{"papermill":{"duration":0.012183,"end_time":"2026-11-27T23:27:53.11016+00:00","exception":false,"start_time":"2026-11-27T23:27:53.097977+00:00","status":"completed"},"tags":[]},"source":["### 3.2 A single dominant hand\n","For the left-handed signers (section 2.7) the clip is **mirrored**: `x → -x` (after centering), and the left / right nodes are swapped (hands, shoulders, elbows, wrists, face pairs). After this step **the right hand (nodes 21-41) is always the dominant hand** and the left hand (nodes 0-20) the non-dominant hand."]},{"cell_type":"code","execution_count":31,"id":"aacf1489","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.136925Z","iopub.status.busy":"2026-11-27T23:27:53.136661Z","iopub.status.idle":"2026-11-27T23:27:53.144513Z","shell.execute_reply":"2026-11-27T23:27:53.143421Z"},"papermill":{"duration":0.022902,"end_time":"2026-11-27T23:27:53.145954+00:00","exception":false,"start_time":"2026-11-27T23:27:53.123052+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["mirrored signers: [16069, 22343, 27610, 32319, 34503, 36257, 37055, 55372, 61333]\n"]}],"source":["MIRROR_SIGNERS = set(by_signer.index[by_signer[\"dominant\"] == \"left\"])\n","print(\"mirrored signers:\", sorted(MIRROR_SIGNERS))\n","\n","# MIRROR_PERM[k] = node that takes the place of node k when left / right are swapped\n","MIRROR_PERM = np.arange(NUM_NODES)\n","MIRROR_PERM[LH] = np.arange(RH.start, RH.stop)\n","MIRROR_PERM[RH] = np.arange(LH.start, LH.stop)\n","for a, b in [(L_SH, R_SH), (L_EL, R_EL), (L_WR, R_WR)] + [(FACE_NODE[a], FACE_NODE[b]) for a, b in FACE_PAIRS]:\n","    MIRROR_PERM[a], MIRROR_PERM[b] = b, a\n","\n","\n","def mirror_clip(xy):\n","    \"\"\"Mirrors a centered clip (T, 92, 2) left / right.\"\"\"\n","    out = xy[:, MIRROR_PERM].copy()\n","    out[..., 0] *= -1\n","    return out\n","\n","\n","# Readable names after mirroring: from here on, right = dominant\n","DOM, NDOM = RH, LH\n","DOM_SH, NDOM_SH, DOM_EL, NDOM_EL, DOM_WR, NDOM_WR = R_SH, L_SH, R_EL, L_EL, R_WR, L_WR"]},{"cell_type":"markdown","id":"9dcf71c7","metadata":{"papermill":{"duration":0.012422,"end_time":"2026-11-27T23:27:53.170177+00:00","exception":false,"start_time":"2026-11-27T23:27:53.157755+00:00","status":"completed"},"tags":[]},"source":["### 3.3 Transformation functions\n","Each function does one thing; they are chained in `clean_clip`."]},{"cell_type":"code","execution_count":32,"id":"9217f5a5","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.195983Z","iopub.status.busy":"2026-11-27T23:27:53.195673Z","iopub.status.idle":"2026-11-27T23:27:53.20224Z","shell.execute_reply":"2026-11-27T23:27:53.201503Z"},"papermill":{"duration":0.0213,"end_time":"2026-11-27T23:27:53.20396+00:00","exception":false,"start_time":"2026-11-27T23:27:53.18266+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def normalize_clip(xy):\n","    \"\"\"Center = middle of the shoulders (mean over the clip), unit = shoulder width (median over the clip).\n","    One transformation for the whole clip: the body motion is preserved.\"\"\"\n","    with warnings.catch_warnings():\n","        warnings.simplefilter(\"ignore\")\n","        center = np.nanmean((xy[:, L_SH] + xy[:, R_SH]) / 2, axis=0)\n","        width = np.nanmedian(np.linalg.norm(xy[:, L_SH] - xy[:, R_SH], axis=-1))\n","    return (xy - center) / width\n","\n","\n","def interp_nan(x):\n","    \"\"\"Replaces NaN by linear interpolation in time. x (T, k, 2); each coordinate is handled on its own.\"\"\"\n","    out = x.copy()\n","    t = np.arange(len(x))\n","    flat = out.reshape(len(x), -1)\n","    for c in range(flat.shape[1]):\n","        ok = np.isfinite(flat[:, c])\n","        if ok.any() and not ok.all():\n","            flat[:, c] = np.interp(t, t[ok], flat[ok, c])\n","    return flat.reshape(x.shape)"]},{"cell_type":"code","execution_count":33,"id":"1c2c3e6d","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.22977Z","iopub.status.busy":"2026-11-27T23:27:53.229257Z","iopub.status.idle":"2026-11-27T23:27:53.234263Z","shell.execute_reply":"2026-11-27T23:27:53.23343Z"},"papermill":{"duration":0.019905,"end_time":"2026-11-27T23:27:53.235855+00:00","exception":false,"start_time":"2026-11-27T23:27:53.21595+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def detected_mask(xy, nodes):\n","    \"\"\"(T,) True if all the points of `nodes` are present in the frame.\"\"\"\n","    return np.isfinite(xy[:, nodes, 0]).all(1)\n","\n","\n","def trim_idle(xy, lead, trail, margin):\n","    \"\"\"Trims the idle frames (start / end without a hand), keeping `margin` frames on each side.\"\"\"\n","    start = max(0, lead - margin)\n","    stop = min(len(xy), len(xy) - trail + margin)\n","    return xy[start:stop]"]},{"cell_type":"markdown","id":"cfa321b1","metadata":{"papermill":{"duration":0.013061,"end_time":"2026-11-27T23:27:53.262161+00:00","exception":false,"start_time":"2026-11-27T23:27:53.2491+00:00","status":"completed"},"tags":[]},"source":["**Rest pose.** In this dataset a hand missing for a long time is almost always a lowered hand outside the image. It is placed at a rest position: the wrist below the shoulder of the same side, with the mean shape of a real hand. The model thus learns to generate a **still** hand instead of a hand that moves for no reason."]},{"cell_type":"code","execution_count":34,"id":"0890061b","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.289848Z","iopub.status.busy":"2026-11-27T23:27:53.289273Z","iopub.status.idle":"2026-11-27T23:27:53.763824Z","shell.execute_reply":"2026-11-27T23:27:53.76258Z"},"papermill":{"duration":0.490168,"end_time":"2026-11-27T23:27:53.765479+00:00","exception":false,"start_time":"2026-11-27T23:27:53.275311+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["wrist at rest, dominant hand: [-0.5   1.49] | non-dominant: [0.5  1.51]\n"]}],"source":["def canonical(i):\n","    \"\"\"Clip i: trimmed, normalized and mirrored if the signer is left-handed (still with its NaN).\"\"\"\n","    row = raw_meta.loc[i]\n","    xy = trim_idle(get_raw(i), int(row[\"lead_idle\"]), int(row[\"trail_idle\"]), CLEAN[\"idle_margin\"])\n","    xy = normalize_clip(xy)\n","    return mirror_clip(xy) if row[\"participant_id\"] in MIRROR_SIGNERS else xy\n","\n","\n","# Mean hand shape (points relative to the wrist) and mean shoulder position, over 1000 kept clips\n","rng = np.random.default_rng(SEED)\n","hand_shapes = {\"dom\": [], \"ndom\": []}\n","shoulders = []\n","for i in rng.choice(np.nonzero(keep.to_numpy())[0], min(1000, int(keep.sum())), replace=False):\n","    xy = canonical(i)\n","    for name, hand in ((\"dom\", DOM), (\"ndom\", NDOM)):\n","        ok = detected_mask(xy, hand)\n","        hand_shapes[name].append(xy[ok][:, hand] - xy[ok][:, hand.start, None])\n","    shoulders.append(np.nanmean(xy[:, [DOM_SH, NDOM_SH]], axis=0))\n","\n","mean_shoulders = np.nanmean(np.stack(shoulders), axis=0)            # (2, 2): dominant, non-dominant shoulder\n","REST_HAND = {}\n","for k, (name, sh) in enumerate(((\"dom\", 0), (\"ndom\", 1))):\n","    shape = np.concatenate(hand_shapes[name]).mean(0)                # (21, 2), wrist at (0, 0)\n","    wrist = mean_shoulders[sh] + np.array([0.0, CLEAN[\"rest_drop\"]])  # below the shoulder (y pointing down)\n","    REST_HAND[name] = (wrist + shape).astype(np.float32)\n","print(\"wrist at rest, dominant hand:\", REST_HAND[\"dom\"][0].round(2), \"| non-dominant:\", REST_HAND[\"ndom\"][0].round(2))"]},{"cell_type":"code","execution_count":35,"id":"3e0c6f1b","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.792082Z","iopub.status.busy":"2026-11-27T23:27:53.791415Z","iopub.status.idle":"2026-11-27T23:27:53.798464Z","shell.execute_reply":"2026-11-27T23:27:53.797881Z"},"papermill":{"duration":0.021657,"end_time":"2026-11-27T23:27:53.799864+00:00","exception":false,"start_time":"2026-11-27T23:27:53.778207+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def fill_hand(xy, hand, detected, rest, max_gap):\n","    \"\"\"Completes a hand frame by frame:\n","       * detected frame -> unchanged;\n","       * short gap (<= max_gap frames) between two detections -> linear interpolation;\n","       * everything else (long absence, before the first / after the last detection) -> hand at rest.\n","    Returns (completed xy, active (T,) bool) with active = detected or interpolated.\"\"\"\n","    xy = xy.copy()\n","    active = detected.copy()\n","    idx = np.nonzero(detected)[0]\n","    for a, b in zip(idx[:-1], idx[1:]):                    # two successive detections a < b\n","        if 1 < b - a <= max_gap + 1:                       # there is a short gap between them\n","            for t in range(a + 1, b):\n","                w = (t - a) / (b - a)\n","                xy[t, hand] = (1 - w) * xy[a, hand] + w * xy[b, hand]\n","            active[a + 1:b] = True\n","    xy[~active, hand] = rest\n","    return xy, active\n","\n","\n","def resample_time(x, n_out):\n","    \"\"\"Linear resampling (T, F) -> (n_out, F).\"\"\"\n","    if len(x) == 1:\n","        return np.repeat(x, n_out, axis=0)\n","    pos = np.linspace(0, len(x) - 1, n_out)\n","    i0 = np.floor(pos).astype(int)\n","    i1 = np.minimum(i0 + 1, len(x) - 1)\n","    w = (pos - i0)[:, None]\n","    return x[i0] * (1 - w) + x[i1] * w"]},{"cell_type":"code","execution_count":36,"id":"9142c20a","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.825708Z","iopub.status.busy":"2026-11-27T23:27:53.825173Z","iopub.status.idle":"2026-11-27T23:27:53.831732Z","shell.execute_reply":"2026-11-27T23:27:53.831035Z"},"papermill":{"duration":0.021026,"end_time":"2026-11-27T23:27:53.833206+00:00","exception":false,"start_time":"2026-11-27T23:27:53.81218+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def clean_clip(i):\n","    \"\"\"Clip i of raw_meta -> (xy (T, 92, 2), presence (T, 3), detection (T, 3), active length).\n","    presence / detection: [dominant hand, non-dominant hand, face];\n","    presence = detected OR interpolated, detection = really seen by MediaPipe.\"\"\"\n","    xy = canonical(i)\n","    det_dom, det_ndom, det_face = detected_mask(xy, DOM), detected_mask(xy, NDOM), detected_mask(xy, FACE)\n","\n","    xy[:, POSE] = interp_nan(xy[:, POSE])                  # the pose and the face only have small gaps\n","    xy[:, FACE] = interp_nan(xy[:, FACE])\n","    xy, act_dom = fill_hand(xy, DOM, det_dom, REST_HAND[\"dom\"], CLEAN[\"max_gap_interp\"])\n","    xy, act_ndom = fill_hand(xy, NDOM, det_ndom, REST_HAND[\"ndom\"], CLEAN[\"max_gap_interp\"])\n","    xy[:, DOM_WR] = xy[:, DOM.start]                       # a single wrist: the hand one\n","    xy[:, NDOM_WR] = xy[:, NDOM.start]\n","    xy = np.nan_to_num(xy)                                 # very rare case: an elbow never detected\n","\n","    T = CLEAN[\"num_frames\"]\n","    xy_T = resample_time(xy.reshape(len(xy), -1), T).reshape(T, NUM_NODES, 2)\n","    src = np.round(np.linspace(0, len(xy) - 1, T)).astype(int)    # nearest original frame (for the masks)\n","    presence = np.stack([act_dom, act_ndom, det_face], 1)[src]\n","    detection = np.stack([det_dom, det_ndom, det_face], 1)[src]\n","    return xy_T.astype(np.float32), presence, detection, len(xy)"]},{"cell_type":"markdown","id":"c007d65a","metadata":{"papermill":{"duration":0.011853,"end_time":"2026-11-27T23:27:53.856509+00:00","exception":false,"start_time":"2026-11-27T23:27:53.844656+00:00","status":"completed"},"tags":[]},"source":["### 3.4 The same clip before and after\n","Top: the raw clip (image coordinates, detection gaps, two wrists). Bottom: the cleaned clip (centered, idle frames trimmed, dominant hand on the right, missing hand at rest, a single wrist). We take a *thirsty* clip of a left-handed signer if there is one, to see the mirroring."]},{"cell_type":"code","execution_count":37,"id":"74ce688e","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:27:53.881752Z","iopub.status.busy":"2026-11-27T23:27:53.881423Z","iopub.status.idle":"2026-11-27T23:27:55.151178Z","shell.execute_reply":"2026-11-27T23:27:55.150443Z"},"papermill":{"duration":1.285242,"end_t