th>\n","    </tr>\n","    <tr>\n","      <th>type</th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>face</th>\n","      <td>0.000</td>\n","    </tr>\n","    <tr>\n","      <th>pose</th>\n","      <td>0.455</td>\n","    </tr>\n","    <tr>\n","      <th>right_hand</th>\n","      <td>0.009</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["            outside the image\n","type                         \n","face                    0.000\n","pose                    0.455\n","right_hand              0.009"]},"metadata":{},"output_type":"display_data"}],"source":["display(df.groupby(\"type\")[[\"x\", \"y\", \"z\"]].agg([\"min\", \"max\"]).round(2))\n","\n","detected = df[\"x\"].notna()\n","outside = (df[[\"x\", \"y\"]] < 0).any(axis=1) | (df[[\"x\", \"y\"]] > 1).any(axis=1)\n","print(\"share of the detected points outside the image, per part:\")\n","display(outside[detected].groupby(df.loc[detected, \"type\"]).mean().round(3).rename(\"outside the image\").to_frame())"]},{"cell_type":"markdown","id":"97944289","metadata":{"papermill":{"duration":0.006168,"end_time":"2026-11-27T23:17:14.66287+00:00","exception":false,"start_time":"2026-11-27T23:17:14.656702+00:00","status":"completed"},"tags":[]},"source":["### 1.5 From the long format to an array\n","To work on a clip, we turn it into an array `(n_frames, 543, 2)`: frame × point × (x, y). The points of a frame always follow the same order: face (0-467), left hand (468-488), pose (489-521), right hand (522-542). Each row is placed using `type` and `landmark_index`, without assuming the rows are sorted."]},{"cell_type":"code","execution_count":7,"id":"b256aae2","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.677255Z","iopub.status.busy":"2026-11-27T23:17:14.676634Z","iopub.status.idle":"2026-11-27T23:17:14.691552Z","shell.execute_reply":"2026-11-27T23:17:14.69079Z"},"papermill":{"duration":0.023728,"end_time":"2026-11-27T23:17:14.693122+00:00","exception":false,"start_time":"2026-11-27T23:17:14.669394+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["array: (23, 543, 2) | share of NaN: 0.059\n"]}],"source":["PART_OFFSET = {\"face\": 0, \"left_hand\": 468, \"pose\": 489, \"right_hand\": 522}   # first point of each part\n","PART_SIZE = {\"face\": 468, \"left_hand\": 21, \"pose\": 33, \"right_hand\": 21}\n","N_LANDMARKS = 543\n","\n","\n","def parquet_to_array(path):\n","    \"\"\"Parquet file -> float32 array (n_frames, 543, 2) with x, y; NaN when a point is missing.\"\"\"\n","    df = pd.read_parquet(path, columns=[\"frame\", \"type\", \"landmark_index\", \"x\", \"y\"])\n","    frames, frame_pos = np.unique(df[\"frame\"].to_numpy(), return_inverse=True)   # frame numbers -> 0, 1, 2...\n","    point = df[\"type\"].map(PART_OFFSET).to_numpy() + df[\"landmark_index\"].to_numpy()\n","    arr = np.full((len(frames), N_LANDMARKS, 2), np.nan, dtype=np.float32)\n","    arr[frame_pos, point] = df[[\"x\", \"y\"]].to_numpy(np.float32)\n","    return arr\n","\n","\n","clip0 = parquet_to_array(DATA_DIR / examples[\"first file\"])\n","print(\"array:\", clip0.shape, \"| share of NaN:\", round(float(np.isnan(clip0).mean()), 3))"]},{"cell_type":"code","execution_count":8,"id":"a2a85404","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.707102Z","iopub.status.busy":"2026-11-27T23:17:14.706731Z","iopub.status.idle":"2026-11-27T23:17:14.905441Z","shell.execute_reply":"2026-11-27T23:17:14.904433Z"},"papermill":{"duration":0.207313,"end_time":"2026-11-27T23:17:14.906982+00:00","exception":false,"start_time":"2026-11-27T23:17:14.699669+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 500x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# One full frame: the 543 points, colored by part (y axis pointing down, as in an image)\n","best_frame = int(np.isfinite(clip0[..., 0]).sum(1).argmax())        # the frame with the most detected points\n","part_colors = {\"face\": \"tab:green\", \"left_hand\": \"tab:blue\", \"pose\": \"black\", \"right_hand\": \"tab:red\"}\n","\n","fig, ax = plt.subplots(figsize=(5, 5))\n","for part, start in PART_OFFSET.items():\n","    pts = clip0[best_frame, start:start + PART_SIZE[part]]\n","    ax.scatter(pts[:, 0], pts[:, 1], s=3, color=part_colors[part], label=f\"{part} ({PART_SIZE[part]})\")\n","ax.invert_yaxis()\n","ax.set_aspect(\"equal\")\n","ax.legend(fontsize=7)\n","ax.set_title(f\"frame {best_frame}: the 543 points\")\n","plt.show()"]},{"cell_type":"markdown","id":"775ab074","metadata":{"papermill":{"duration":0.006891,"end_time":"2026-11-27T23:17:14.920233+00:00","exception":false,"start_time":"2026-11-27T23:17:14.913342+00:00","status":"completed"},"tags":[]},"source":["### 1.6 The points we keep\n","We do not keep all 543 points:\n","\n","| Part | Kept | Reason |\n","|---|---|---|\n","| Hands (2 × 21) | yes | they carry most of the meaning of the sign |\n","| Shoulders, elbows, wrists of the *pose* | yes | arm position; the pose wrist will be replaced by the hand wrist |\n","| Rest of the *pose* (legs, hips, coarse fingers, head) | no | outside the frame or redundant with the hands and the face |\n","| Face: 44 points (lips, brows, eyes, nose, forehead, chin, cheeks) | yes | expressions (mouth, brows) are part of ASL; the full mesh (468 points) would drown the hands |\n","\n","The face points are chosen **as symmetric pairs** (left / right): this lets us mirror a clip cleanly (section 3)."]},{"cell_type":"code","execution_count":9,"id":"08457c73","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.934947Z","iopub.status.busy":"2026-11-27T23:17:14.934435Z","iopub.status.idle":"2026-11-27T23:17:14.942519Z","shell.execute_reply":"2026-11-27T23:17:14.941856Z"},"papermill":{"duration":0.017089,"end_time":"2026-11-27T23:17:14.943973+00:00","exception":false,"start_time":"2026-11-27T23:17:14.926884+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["92 nodes: 2 x 21 hands + 6 pose + 44 face\n"]}],"source":["# MediaPipe pose: 11/12 shoulders, 13/14 elbows, 15/16 wrists (left / right)\n","POSE_KEEP = [11, 12, 13, 14, 15, 16]\n","\n","# MediaPipe face (468-point mesh)\n","FACE_MID = [0, 17, 13, 14, 1, 168, 10, 152]   # on the face axis: lips (top, bottom, inner top/bottom), nose, between the eyes, forehead, chin\n","FACE_PAIRS = [                                # symmetric pairs (side A, side B)\n","    (61, 291), (37, 267), (40, 270), (84, 314), (91, 321),                 # outer lips (corners + contour)\n","    (78, 308), (82, 312), (87, 317),                                       # inner lips\n","    (70, 300), (63, 293), (105, 334), (66, 296), (107, 336),               # brows\n","    (33, 263), (133, 362), (159, 386), (145, 374),                         # eyes: outer corner, inner corner, upper lid, lower lid\n","    (234, 454),                                                            # cheeks\n","]\n","FACE_KEEP = FACE_MID + [a for a, b in FACE_PAIRS] + [b for a, b in FACE_PAIRS]\n","\n","# The 92 kept points, in the \"node\" order used throughout the notebook\n","KEPT_LANDMARKS = ([PART_OFFSET[\"left_hand\"] + i for i in range(21)]\n","                  + [PART_OFFSET[\"right_hand\"] + i for i in range(21)]\n","                  + [PART_OFFSET[\"pose\"] + i for i in POSE_KEEP]\n","                  + [PART_OFFSET[\"face\"] + i for i in FACE_KEEP])\n","NUM_NODES = len(KEPT_LANDMARKS)\n","\n","LH = slice(0, 21)                     # left hand (MediaPipe label)\n","RH = slice(21, 42)                    # right hand\n","POSE = slice(42, 48)                  # shoulders, elbows, wrists\n","FACE = slice(48, NUM_NODES)           # 44 face points\n","L_SH, R_SH, L_EL, R_EL, L_WR, R_WR = range(42, 48)\n","FACE_NODE = {lm: FACE.start + k for k, lm in enumerate(FACE_KEEP)}    # MediaPipe face index -> node\n","\n","print(f\"{NUM_NODES} nodes: 2 x 21 hands + {len(POSE_KEEP)} pose + {len(FACE_KEEP)} face\")"]},{"cell_type":"code","execution_count":10,"id":"bcdaca0b","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.956829Z","iopub.status.busy":"2026-11-27T23:17:14.956279Z","iopub.status.idle":"2026-11-27T23:17:15.210997Z","shell.execute_reply":"2026-11-27T23:17:15.210285Z"},"papermill":{"duration":0.262832,"end_time":"2026-11-27T23:17:15.212587+00:00","exception":false,"start_time":"2026-11-27T23:17:14.949755+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 500x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# The kept points (in color) among the 543 (in gray), on the same frame\n","kept = clip0[best_frame, KEPT_LANDMARKS]\n","fig, ax = plt.subplots(figsize=(5, 5))\n","ax.scatter(clip0[best_frame, :, 0], clip0[best_frame, :, 1], s=2, color=\"0.8\", label=\"not kept\")\n","ax.scatter(kept[LH, 0], kept[LH, 1], s=8, color=\"tab:blue\", label=\"left hand\")\n","ax.scatter(kept[RH, 0], kept[RH, 1], s=8, color=\"tab:red\", label=\"right hand\")\n","ax.scatter(kept[POSE, 0], kept[POSE, 1], s=20, color=\"black\", label=\"shoulders, elbows, wrists\")\n","ax.scatter(kept[FACE, 0], kept[FACE, 1], s=8, color=\"tab:green\", label=\"face (44)\")\n","for a, b in FACE_PAIRS:                                    # a line joins the two points of each symmetric pair\n","    pa, pb = kept[FACE_NODE[a]], kept[FACE_NODE[b]]\n","    ax.plot([pa[0], pb[0]], [pa[1], pb[1]], color=\"tab:green\", lw=0.4)\n","ax.invert_yaxis()\n","ax.set_aspect(\"equal\")\n","ax.legend(fontsize=7)\n","ax.set_title(\"kept points\")\n","plt.show()"]},{"cell_type":"markdown","id":"7f9b72c5","metadata":{"papermill":{"duration":0.005956,"end_time":"2026-11-27T23:17:15.225343+00:00","exception":false,"start_time":"2026-11-27T23:17:15.219387+00:00","status":"completed"},"tags":[]},"source":["## 2. Exploring the full dataset\n","\n","We now read **all** the files once. For each clip we keep:\n","* the 92 kept nodes (x, y), without any transformation (raw data);\n","* quality statistics: number of frames, share of frames where each part is detected, idle frames at the start and at the end, longest detection gap of a hand, points outside the image, shoulder width.\n","\n","The frames of all clips are stored end to end in a single file (`raw_frames.npy`); `raw_offsets.npy` tells where each clip starts. The result is cached.\n","\n","The raw cache is only used by this notebook: it is deleted at the end (section 5)."]},{"cell_type":"code","execution_count":11,"id":"aa5c9eca","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:15.239091Z","iopub.status.busy":"2026-11-27T23:17:15.238332Z","iopub.status.idle":"2026-11-27T23:17:15.243395Z","shell.execute_reply":"2026-11-27T23:17:15.242823Z"},"papermill":{"duration":0.013414,"end_time":"2026-11-27T23:17:15.244809+00:00","exception":false,"start_time":"2026-11-27T23:17:15.231395+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def longest_run(mask):\n","    \"\"\"Length of the longest run of consecutive True values in a boolean array.\"\"\"\n","    best = run = 0\n","    for m in mask:\n","        run = run + 1 if m else 0\n","        best = max(best, run)\n","    return best\n","\n","\n","def longest_gap(detected):\n","    \"\"\"Longest detection gap BETWEEN the first and the last detection (0 if never detected).\"\"\"\n","    idx = np.nonzero(detected)[0]\n","    if len(idx) == 0:\n","        return 0\n","    return longest_run(~detected[idx[0]:idx[-1] + 1])"]},{"cell_type":"code","execution_count":12,"id":"22ff1e50","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:15.257898Z","iopub.status.busy":"2026-11-27T23:17:15.257671Z","iopub.status.idle":"2026-11-27T23:17:15.265534Z","shell.execute_reply":"2026-11-27T23:17:15.264834Z"},"papermill":{"duration":0.016206,"end_time":"2026-11-27T23:17:15.266996+00:00","exception":false,"start_time":"2026-11-27T23:17:15.25079+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def scan_clip(rel_path):\n","    \"\"\"Reads a parquet file -> (raw nodes (n, 92, 2) as float16, dict of quality statistics).\"\"\"\n","    path = DATA_DIR / rel_path\n","    xy = parquet_to_array(path)[:, KEPT_LANDMARKS]          # (n, 92, 2)\n","    n = len(xy)\n","    left = np.isfinite(xy[:, LH, 0]).all(1)                 # left hand detected in each frame\n","    right = np.isfinite(xy[:, RH, 0]).all(1)\n","    face = np.isfinite(xy[:, FACE, 0]).all(1)\n","    pose = np.isfinite(xy[:, POSE, 0]).all(1)\n","    any_hand = left | right\n","    hand_frames = np.nonzero(any_hand)[0]\n","\n","    hands = xy[:, :42][np.isfinite(xy[:, :42, 0])]           # all detected hand points\n","    with warnings.catch_warnings():\n","        warnings.simplefilter(\"ignore\")                      # nanmedian warns when everything is NaN\n","        shoulder = float(np.nanmedian(np.linalg.norm(xy[:, L_SH] - xy[:, R_SH], axis=-1)))\n","\n","    stats = {\n","        \"n_frames\": n,\n","        \"rows_ok\": pq.ParquetFile(path).metadata.num_rows == n * N_LANDMARKS,   # 543 rows per frame?\n","        \"file_kb\": path.stat().st_size / 1e3,\n","        \"left_frac\": left.mean(), \"right_frac\": right.mean(), \"face_frac\": face.mean(), \"pose_frac\": pose.mean(),\n","        \"both_frac\": (left & right).sum() / max(any_hand.sum(), 1),          # both hands / at least one hand\n","        \"hand_frac\": any_hand.mean(),                                        # at least one hand detected\n","        \"no_hand\": len(hand_frames) == 0,\n","        \"lead_idle\": hand_frames[0] if len(hand_frames) else n,              # frames without a hand at the start\n","        \"trail_idle\": n - 1 - hand_frames[-1] if len(hand_frames) else n,    # frames without a hand at the end\n","        \"gap_left\": longest_gap(left), \"gap_right\": longest_gap(right),\n","        \"out_of_frame\": float(((hands < 0) | (hands > 1)).mean()) if len(hands) else 0.0,\n","        \"shoulder_width\": shoulder,\n","    }\n","    return xy.astype(np.float16), stats"]},{"cell_type":"code","execution_count":13,"id":"7d60a53c","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:15.280505Z","iopub.status.busy":"2026-11-27T23:17:15.280156Z","iopub.status.idle":"2026-11-27T23:27:45.529757Z","shell.execute_reply":"2026-11-27T23:27:45.528497Z"},"papermill":{"duration":630.260298,"end_time":"2026-11-27T23:27:45.533503+00:00","exception":false,"start_time":"2026-11-27T23:17:15.273205+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"70918998ff9c4cd8a225cb6bed3122d5","version_major":2,"version_minor":0},"text/plain":["reading:   0%|          | 0/94477 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["94477 clips | 3583987 frames in total\n"]}],"source":["raw_paths = {\"frames\": CACHE_DIR / \"raw_frames.npy\", \"offsets\": CACHE_DIR / \"raw_offsets.npy\", \"meta\": CACHE_DIR / \"raw_meta.csv\"}\n","\n","if all(p.exists() for p in raw_paths.values()):\n","    print(\"cache found: reading\", CACHE_DIR)\n","else:\n","    clips = train_csv.sample(min(3000, len(train_csv)), random_state=SEED) if QUICK_TEST else train_csv\n","    clips = clips.reset_index(drop=True)\n","    # Parallel reading with several processes (on Windows a notebook cannot do it: 1 process)\n","    n_proc = min(4, os.cpu_count() or 1) if os.name != \"nt\" else 1\n","    if n_proc > 1:\n","        from multiprocessing import Pool\n","        with Pool(n_proc) as pool:\n","            results = list(tqdm(pool.imap(scan_clip, clips[\"path\"], chunksize=64), total=len(clips), desc=\"reading\"))\n","    else:\n","        results = [scan_clip(p) for p in tqdm(clips[\"path\"], desc=\"reading\")]\n","\n","    arrays = [r[0] for r in results]\n","    offsets = np.conca