 is detected, then frame by frame."]},{"cell_type":"code","execution_count":5,"id":"94d4cc12","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.263286Z","iopub.status.busy":"2026-11-27T23:17:14.262863Z","iopub.status.idle":"2026-11-27T23:17:14.582093Z","shell.execute_reply":"2026-11-27T23:17:14.581224Z"},"papermill":{"duration":0.327896,"end_time":"2026-11-27T23:17:14.583813+00:00","exception":false,"start_time":"2026-11-27T23:17:14.255917+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["first file       share of frames where the part is detected: {'face': 1.0, 'left_hand': 0.0, 'pose': 1.0, 'right_hand': 0.48}\n","word thirsty     share of frames where the part is detected: {'face': 1.0, 'left_hand': 0.0, 'pose': 1.0, 'right_hand': 0.83}\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1000x260 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def detection_per_frame(df):\n","    \"\"\"Table (frames x parts): True if the body part is detected in the frame.\"\"\"\n","    detected = df.groupby([\"frame\", \"type\"])[\"x\"].apply(lambda v: v.notna().all())\n","    return detected.unstack()\n","\n","\n","example_detection = {}\n","for name, p in examples.items():\n","    example_detection[name] = detection_per_frame(pd.read_parquet(DATA_DIR / p))\n","    print(f\"{name:16s} share of frames where the part is detected:\", example_detection[name].mean().round(2).to_dict())\n","\n","# Timeline: one row per body part, one column per frame (light = detected, dark = missing)\n","fig, axes = plt.subplots(len(example_detection), 1, figsize=(10, 1.3 * len(example_detection)), squeeze=False)\n","for ax, (name, det) in zip(axes[:, 0], example_detection.items()):\n","    ax.imshow(det.T.astype(float).values, aspect=\"auto\", cmap=\"Greens\", vmin=0, vmax=1, interpolation=\"nearest\")\n","    ax.set_yticks(range(det.shape[1]))\n","    ax.set_yticklabels(det.columns, fontsize=7)\n","    ax.set_title(name, fontsize=9, loc=\"left\")\n","axes[-1, 0].set_xlabel(\"frame\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"b0de618a","metadata":{"papermill":{"duration":0.006174,"end_time":"2026-11-27T23:17:14.596591+00:00","exception":false,"start_time":"2026-11-27T23:17:14.590417+00:00","status":"completed"},"tags":[]},"source":["### 1.4 Value ranges\n","`x, y` values outside [0, 1] are points estimated **outside the image**. `z` does not have the same scale for every body part (for the hands it is relative to the wrist): this is why the notebook **does not use z** (depth is recovered later by the 3D avatar)."]},{"cell_type":"code","execution_count":6,"id":"95afa091","metadata":{"execution":{"iopub.execute_input":"2026-11-27T23:17:14.609675Z","iopub.status.busy":"2026-11-27T23:17:14.608912Z","iopub.status.idle":"2026-11-27T23:17:14.649012Z","shell.execute_reply":"2026-11-27T23:17:14.648334Z"},"papermill":{"duration":0.048039,"end_time":"2026-11-27T23:17:14.650567+00:00","exception":false,"start_time":"2026-11-27T23:17:14.602528+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead tr th {\n","        text-align: left;\n","    }\n","\n","    .dataframe thead tr:last-of-type th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr>\n","      <th></th>\n","      <th colspan=\"2\" halign=\"left\">x</th>\n","      <th colspan=\"2\" halign=\"left\">y</th>\n","      <th colspan=\"2\" halign=\"left\">z</th>\n","    </tr>\n","    <tr>\n","      <th></th>\n","      <th>min</th>\n","      <th>max</th>\n","      <th>min</th>\n","      <th>max</th>\n","      <th>min</th>\n","      <th>max</th>\n","    </tr>\n","    <tr>\n","    